-- dim_cust quality check 
-- checking for duplicate id in the gold.dim_customer
SELECT 
customer_id
,count(*)
FROM gold.dim_customer
GROUP BY customer_id
HAVING count(*) > 1

-- check for distinct gender 
SELECT 
DISTINCT Gender
FROM gold.dim_customer

